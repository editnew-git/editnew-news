<!-- This is a public embed ID, not an administrator API key. -->
<script is:inline>
  (() => {
    let focusComposer = false;
    let returnFocus = false;
    const enhanceChat = () => {
      const launcher = document.getElementById('anything-llm-embed-chat-button');
      if (launcher) {
        launcher.setAttribute('aria-label', 'Ask Editnew AI');
        if (returnFocus) {
          launcher.focus();
          returnFocus = false;
        }
      }
      const panel = document.getElementById('anything-llm-chat');
      if (!panel) return;
      panel.setAttribute('role', 'region');
      panel.setAttribute('aria-label', 'Editnew AI support');
      const composer = panel.querySelector('textarea');
      if (composer) {
        composer.maxLength = 1500;
        composer.setAttribute('aria-label', 'Your support question');
        if (focusComposer) {
          composer.focus();
          focusComposer = false;
        }
      }
    };
    new MutationObserver(enhanceChat).observe(document.body, { childList: true, subtree: true });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('#anything-llm-embed-chat-button')) focusComposer = true;
      if (event.target.closest('#anything-llm-header button[aria-label="Close"]')) returnFocus = true;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        document.querySelector('#anything-llm-header button[aria-label="Close"]')?.click();
      }
    });
  })();
</script>
