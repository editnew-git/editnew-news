---
import { getCollection } from 'astro:content';
import '../styles/supportChat.css';
const guides = (await getCollection('news', ({ data }) => !data.draft)).map(({ data }) => ({
  title: data.title, url: `https://support.editnew.ca/news/${data.slug}/`,
}));
const turnstileSiteKey = import.meta.env.PUBLIC_SUPPORT_TURNSTILE_SITE_KEY?.trim() || '';
const requestsEnabled = import.meta.env.PUBLIC_SUPPORT_REQUESTS_ENABLED === 'true' && Boolean(turnstileSiteKey);
---
<!-- Public embed ID only. Chat authorization and limits remain on the server. -->
<div class="support-chat" data-support-chat data-guides={JSON.stringify(guides)} data-embed-id="86c54a7e-8c04-48f8-b17c-9a4fe247ef24">
  <button class="chat-launcher" data-launcher aria-label="Ask Sam AI" aria-controls="sam-chat-panel" aria-expanded="false" hidden>
    <img src="/images/brand/sam-ai-icon.png" alt="" width="36" height="36" /> Ask Sam AI
  </button>
  <section id="sam-chat-panel" class="chat-panel" role="dialog" aria-label="Sam AI support" hidden>
    <header class="chat-header">
      <img src="/images/brand/sam-ai-icon.png" alt="" width="42" height="42" />
      <div><strong>Sam AI</strong><span>Your Editnew guide assistant</span></div>
      <button class="chat-icon-button" data-close aria-label="Close chat" title="Close chat">×</button>
    </header>
    <div class="chat-reading-area">
      <div class="chat-scroll" data-scroll tabindex="0" aria-label="Conversation">
        <div class="chat-welcome" data-welcome>
          <span class="chat-eyebrow">A little help, right here</span>
          <h2>Hi! What can I<br />help you with?</h2>
          <p>Ask about S.A.M. or RunSam, or start with one of these.</p>
          <div class="chat-starters">
            <button data-question="How do I reset my RunSam password?"><span>Reset password</span><span aria-hidden="true">↗</span></button>
            <button data-choices="connect"><span>Connect a device</span><span aria-hidden="true">→</span></button>
            <button data-choices="display"><span>Fix a display issue</span><span aria-hidden="true">→</span></button>
          </div>
          <div class="chat-choices" data-choices-panel hidden></div>
        </div>
        <div class="chat-messages" data-messages></div>
        <div class="chat-followups" data-followups hidden>
          <p>How did it go?</p>
          <div><button data-resolved>That worked</button><button data-question="I’m still having trouble. What should I check next?">Still having trouble</button><button data-explain>Explain this step</button></div>
        </div>
        <p class="chat-notice" data-notice hidden></p>
      </div>
      <button class="chat-jump" data-jump hidden>Jump to latest ↓</button>
    </div>
    <div class="chat-error" data-error hidden>
      <p data-error-text role="alert"></p>
      <button data-retry>Retry reply</button>
    </div>
    {requestsEnabled && <section class="chat-request" data-request-panel data-sitekey={turnstileSiteKey} aria-labelledby="sam-request-heading" hidden>
      <div class="chat-request-heading"><h2 id="sam-request-heading" tabindex="-1">Request support</h2><button class="chat-icon-button" data-close-request aria-label="Back to chat">×</button></div>
      <form data-request-form>
        <fieldset data-request-fields>
          <legend class="sr-only">Support request details</legend>
          <p>Our team will review your request and follow up by email. Fields marked * are required.</p>
          <label for="sam-request-name">Your name *</label>
          <input id="sam-request-name" name="name" autocomplete="name" maxlength="120" required />
          <label for="sam-request-email">Email *</label>
          <input id="sam-request-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <label for="sam-request-company">Company / location *</label>
          <input id="sam-request-company" name="company" autocomplete="organization" maxlength="200" required />
          <label for="sam-request-problem">What is the problem? *</label>
          <textarea id="sam-request-problem" name="problem" rows="4" maxlength="4000" required></textarea>
          <label for="sam-request-steps">Steps you have already tried (optional)</label>
          <textarea id="sam-request-steps" name="steps_attempted" rows="3" maxlength="2000"></textarea>
          <details>
            <summary>Add phone, product, or sign details</summary>
            <label for="sam-request-phone">Phone (optional)</label>
            <input id="sam-request-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" />
            <label for="sam-request-product">Product (optional)</label>
            <input id="sam-request-product" name="product" maxlength="120" placeholder="S.A.M. or RunSam" />
            <label for="sam-request-sign">Sign number (optional)</label>
            <input id="sam-request-sign" name="reported_sign" maxlength="80" />
          </details>
          <label class="chat-request-check" for="sam-request-include-chat"><input id="sam-request-include-chat" type="checkbox" data-request-include-chat /> Include recent chat messages</label>
          <div data-request-chat-review hidden>
            <p id="sam-request-excerpt-help">Review what will be shared. Sam AI suggestions are not steps you have necessarily tried. Remove any private account details.</p>
            <label for="sam-request-excerpt">Conversation excerpt</label>
            <textarea id="sam-request-excerpt" name="conversation_excerpt" rows="5" maxlength="4000" aria-describedby="sam-request-excerpt-help"></textarea>
          </div>
          <div class="chat-request-trap" aria-hidden="true"><label for="sam-request-website">Website</label><input id="sam-request-website" name="website" tabindex="-1" autocomplete="off" /></div>
          <p>Please do not include passwords or payment details. Submitting shares these details with the Editnew support team.</p>
          <div data-request-challenge></div>
          <p class="chat-request-status" data-request-challenge-status role="status"></p>
          <button type="button" data-retry-challenge hidden>Retry verification</button>
          <button class="chat-primary" type="submit" data-request-submit disabled>Submit request</button>
        </fieldset>
        <p class="chat-request-error" data-request-error role="alert" hidden></p>
        <div class="chat-request-receipt" data-request-receipt tabindex="-1" role="status" hidden></div>
      </form>
      <p class="chat-request-fallback">You can also email <a href="mailto:info@editnew.ca">info@editnew.ca</a>.</p>
    </section>}
    <form class="chat-composer" data-form>
      <label for="sam-question" class="sr-only">Your support question</label>
      <div class="chat-input-row">
        <textarea id="sam-question" data-input rows="1" maxlength="1500" placeholder="Ask about S.A.M. or RunSam…" aria-describedby="sam-input-help"></textarea>
        <button class="chat-send" data-send type="submit" aria-label="Send message" disabled>↑</button>
      </div>
      <div class="chat-input-help" id="sam-input-help"><span data-status role="status" aria-live="polite">Enter to send · Shift + Enter for a new line</span><span data-count hidden></span></div>
    </form>
    <footer class="chat-footer">
      <div>{requestsEnabled ? <button data-support>Request support</button> : <a href="mailto:info@editnew.ca">Email support ↗</a>}<button data-reset>Reset chat</button></div>
      <p>AI answers from our guides can make mistakes.<br />Please don’t share passwords or private account details.</p>
    </footer>
    <div class="chat-reset-confirm" data-reset-confirm hidden>
      <p>Clear this conversation? This cannot be undone.</p>
      <button data-confirm-reset>Clear conversation</button><button data-cancel-reset>Keep chatting</button>
    </div>
  </section>
</div>
<script>
  import { initializeSupportChat } from '../lib/supportChat.js';
  document.querySelectorAll('[data-support-chat]').forEach(initializeSupportChat);
</script>
